# Dapatkan dari https://my.telegram.org
API_ID=123456
API_HASH=isi_api_hash_kamu
SESSION_NAME=prank_session
# Kosongkan untuk lokal. Wajib diisi untuk Heroku (python generate_session.py)
SESSION_STRING=

# ---- TELEPON ----
# Durasi maksimal telepon (detik). 300 = 5 menit
MAX_CALL_SECONDS=300
# Jeda hening acak antar audio (detik)
GAP_MIN=1
GAP_MAX=4

# Kosongkan = semua orang kena prank.
# Isi user id dipisah koma untuk membatasi, contoh: 12345,67890
ALLOWED_IDS=

# ---- CHAT ----
# Delay acak sebelum mulai "mengetik..." (detik)
CHAT_DELAY_MIN=5
CHAT_DELAY_MAX=40
# Lama sekali mengetik (detik)
TYPING_MIN=4
TYPING_MAX=12
# Berapa kali mengetik-berhenti-mengetik lagi
BURSTS_MIN=1
BURSTS_MAX=3
# Cooldown per orang agar tidak terlalu sering (detik)
CHAT_COOLDOWN=120
